# Postgres — your database connection
# Use the raw connection URL from your provider, without unsupported params like channel_binding.
# For Neon/Vercel, this format is usually fine: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=""
DATABASE_URL_POOLED=""

# NextAuth
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Public app URL — used in emails and activation/reset links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend — transactional email
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Bekur <onboarding@resend.dev>"

# Firebase Cloud Messaging — server (Admin SDK service account)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Firebase Cloud Messaging — client (web app config)
# These must also be copied by hand into public/firebase-messaging-sw.js,
# since service workers can't read env vars.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# Reports — IANA time zone used to bucket calls by day/hour on the Reports page
REPORTS_TIMEZONE="Africa/Addis_Ababa"

# Vercel Cron — shared secret to protect scheduled endpoints
CRON_SECRET=""
